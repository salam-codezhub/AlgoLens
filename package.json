{
  "name": "algolens",
  "version": "0.1.0",
  "private": true,
  "description": "AlgoLens — AI-powered VS Code extension for code analysis, optimization, benchmarking and documentation.",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "dev:extension": "npm run dev --workspace apps/extension",
    "dev:webview": "npm run dev --workspace apps/webview",
    "clean": "npm run clean --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/vscode": "1.125.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vscode/vsce": "3.9.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.1"
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  }
}
