{
  "name": "algolens-toolkit",
  "displayName": "AlgoLens Code Intelligence",
  "description": "Analyze. Optimize. Accelerate. AI-powered code analysis, optimization, benchmarking and documentation, right inside VS Code.",
  "version": "0.1.2",
  "publisher": "algolens-dev",
  "license": "MIT",
  "keywords": [
    "code analysis",
    "code optimization",
    "complexity analysis",
    "security",
    "benchmarking",
    "documentation",
    "AI",
    "developer tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/salam-codezhub/AlgoLens.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Machine Learning",
    "Visualization"
  ],
  "main": "dist/extension.js",
  "icon": "icon.png",
  "files": [
    "dist/**",
    "webview/**",
    "README.md",
    "icon.png",
    "LICENSE*",
    "package.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "algolens.showInfo",
        "title": "AlgoLens: Show Extension Info"
      },
      {
        "command": "algolens.showWorkspaceContext",
        "title": "AlgoLens: Show Workspace Context"
      },
      {
        "command": "algolens.showDashboard",
        "title": "AlgoLens: Show Dashboard"
      }
    ]
  },
  "dependencies": {
    "@algolens/analyzer": "^0.1.0",
    "@algolens/core": "^0.1.0",
    "@algolens/parser": "^0.1.0",
    "@algolens/shared": "^0.1.0",
    "@algolens/storage": "^0.1.0"
  },
  "scripts": {
    "build": "webpack --config webpack.config.cjs --mode production && node copy-webview.cjs",
    "dev": "webpack --config webpack.config.cjs --mode development --watch",
    "clean": "rimraf dist"
  }
}
